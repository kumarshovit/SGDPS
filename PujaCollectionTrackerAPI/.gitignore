# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# =========================================================================
# .NET Core & C# Compilation Artifacts
# =========================================================================
[Bb]in/
[Oo]bj/
*.msi
*.tlh
*.tli
*.hover
*.modules
*.generated
_wpf/
*.DotSettings.user

# =========================================================================
# .NET Aspire & App Host Runtime Outputs
# =========================================================================
.apphost/
.aspire/
src/*Host/bin/
src/*Host/obj/

# =========================================================================
# NuGet & Dependency Management
# =========================================================================
# Triggered during explicit project updates and package restores
*.nuget.props
*.nuget.targets
/packages/

# =========================================================================
# Code Coverage, Test, and Reporting Reports
# =========================================================================
TEST*.xml
*.trx
*.coverage
*.md.html
/TestResults/
/unittests/TestResults/
/.reportgenerator/

# =========================================================================
# Local Configuration and User-Specific Secrets
# =========================================================================
# Never check in local database files or environment files containing secrets
*.db
*.db-shm
*.db-wal
.env
.env.*

# =========================================================================
# Development Tools and IDE Configurations
# =========================================================================
# Rider, Visual Studio, and VS Code tracking directories
.idea/
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# =========================================================================
# Operating System Generated Files
# =========================================================================
# Generated by MacOS
.DS_Store
.AppleDouble
.LSOverride

# Generated by Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# =========================================================================
# Application Binaries & Large Media Archives
# =========================================================================
*.app
*.exe
*.war
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv
