# ==========================================
# Root .gitignore for SGDPS Monorepo
# ==========================================

# ------------------------------------------
# 1. .NET / C# (PujaCollectionTrackerAPI)
# ------------------------------------------
**/bin/
**/obj/
**/.vs/
**/*.user
**/*.userosscache
**/*.suo
**/*.userprefs
**/packages/
**/TestResults/
**/appsettings.Development.json
**/appsettings.Local.json
**/*.db
**/*.db-shm
**/*.db-wal
**/_ReSharper*/
**/*.dotCover

# ------------------------------------------
# 2. Node.js & React (SGDPSWebsite)
# ------------------------------------------
**/node_modules/
**/dist/
**/build/
**/.pnp
**/.pnp.js
**/coverage/
**/.npm
**/.eslintcache
**/.vite/
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ------------------------------------------
# 3. Flutter & Dart (SGDPSMobile)
# ------------------------------------------
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/android/.gradle/
**/android/local.properties
**/android/app/release/
**/*.apk
**/*.aab
**/*.ipa

# ------------------------------------------
# 4. OS & IDE Metadata
# ------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
**/.idea/
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/launch.json
*.log
*.tmp
